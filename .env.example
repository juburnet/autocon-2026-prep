# Copy this file to .env and fill in real values, then `source .env`
# before running terraform in meraki/ or ios-xe/. Never commit the real .env file
# (it's gitignored already) — this repo is public.

# ---- meraki/ -----------------------------------------------------------
# Meraki Dashboard API provider auth
export MERAKI_DASHBOARD_API_KEY=

# !env-tagged values referenced across meraki/data/*.nac.yaml
export org_name=
export branch1_mx_serial=
export branch1_ms_serial=
export branch1_cw_serial=
export branch2_mx_serial=
export branch2_ms_serial=
export branch2_cw_serial=
export vpn_hub_network_name=Datacenter

##
## NO NEED TO CHANGE THE VALUES BELOW - THESE ARE EXAMPLE CREDENTIALS FOR TESTING PURPOSES ONLY.
##
## DO NOT USE REAL CREDENTIALS IN THIS FILE. ##
## In production make use of the GitHub Secrets feature to store sensitive information and reference them in your workflows. ##
##
# ── Credentials (non-secret, example values) ────────────────────────────────
export org_admin=admin
export org_admin_email=admin-branch@netascode.cisco.com
export v3_auth_pass=Cisco12345
export v3_priv_pass=Cisco12345
export local_status_page_username=admin
export local_page_username=admin
export local_status_page_password=Cisco!12345C60972A
export local_page_password=Cisco!12345C60972A
export radius_accounting_server_secret=Cisco12345!
export radius_server_secret=Cisco12345!
export snmp_username=admin
export snmp_passphrase=Cisco!12345C60972A

# ---- ios-xe/ ------------------------------------------------------------
# Shared SSH credentials for all 4 devices (CiscoDevNet/iosxe provider, NETCONF)
export IOSXE_USERNAME=
export IOSXE_PASSWORD=
# Optional - skip SSH host-key verification (useful for CML-hosted lab nodes).
# Already the provider default, uncomment only to be explicit.
# export IOSXE_INSECURE=true
