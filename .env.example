# Copy this file to .env and fill in real values, then `set -a; source .env; set +a`
# before running terraform in meraki/ or ios-xe/. Never commit the real .env file
# (it's gitignored already) — this repo is public.

# ---- meraki/ -----------------------------------------------------------
# Meraki Dashboard API provider auth
MERAKI_DASHBOARD_API_KEY=

# !env-tagged values referenced across meraki/data/*.nac.yaml
org_name=
branch1_mx_serial=
branch1_ms_serial=
branch1_cw_serial=
branch2_mx_serial=
branch2_ms_serial=
branch2_cw_serial=
vpn_hub_network_name=
local_page_username=
local_page_password=
snmp_username=
snmp_passphrase=
v3_auth_pass=
v3_priv_pass=
radius_server_secret=
radius_accounting_server_secret=

# ---- ios-xe/ ------------------------------------------------------------
# Shared SSH credentials for all 6 devices (CiscoDevNet/iosxe provider, NETCONF)
IOSXE_USERNAME=
IOSXE_PASSWORD=
# Optional - skip SSH host-key verification (useful for CML-hosted lab nodes).
# Already the provider default, uncomment only to be explicit.
# IOSXE_INSECURE=true
